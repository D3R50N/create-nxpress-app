<div class="min-h-screen sm:h-screen flex flex-col justify-between max-w-5xl mx-auto px-6 py-6 overflow-hidden">
  <header class="flex items-center justify-between py-3 border-b border-neutral-200 dark:border-neutral-900 shrink-0">
    <div class="flex items-center gap-3">
      <span class="font-bold text-base text-neutral-900 dark:text-neutral-100 tracking-tight">Nxpress</span>
      <span class="text-xs font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800">
        v<%= version %>
      </span>
    </div>
    <div class="flex items-stretch gap-3">
      <% if (!E.NODE_ENV || E.NODE_ENV.toLowerCase() !=='prod' ) { %>
      <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-medium bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-800">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_#10b981] animate-pulse"></span>
        Dev Server
      </span>
      <% } %>
      <button onclick="__nxpress__.theme.toggle()" type="button" aria-label="Toggle theme" class="p-1.5 rounded-md text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 transition-colors">
        <%- icon('moon', 'w-4 h-4 dark:hidden' ) %>
        <%- I('sun', 'w-4 h-4 hidden dark:block' ) %>
      </button>
    </div>
  </header>

  <main class="py-6 text-center my-auto flex flex-col items-center justify-center">
    <div class="mb-6">
      <img src="/logo.svg" alt="Nxpress" class="w-16 h-16 object-contain mx-auto" />
    </div>

    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-4 max-w-2xl leading-tight">
      <%= title %>
    </h1>

    <p class="text-base text-neutral-600 dark:text-neutral-400 max-w-lg mx-auto mb-8 leading-relaxed">
      <%= description %>
    </p>

    <div class="w-full max-w-md mx-auto mb-10">
      <div class="rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800/80 px-4 py-3 text-left font-mono text-sm shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-neutral-600 dark:text-neutral-400">Edit <code class="text-neutral-900 dark:text-neutral-100 font-semibold px-1">app/index.ejs</code></span>
          <span class="text-xs text-neutral-400 dark:text-neutral-500 font-sans">Save to reload</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 w-full max-w-3xl text-left border-t border-neutral-200 dark:border-neutral-900/80 pt-6">
      <%- features.map((feat)=> $("FeatureCard", {feat})).join('') %>
    </div>
  </main>

  <footer class="py-4 border-t border-neutral-200 dark:border-neutral-900 text-center text-xs text-neutral-500 dark:text-neutral-600 flex items-center justify-between shrink-0">
    <p>Nxpress Framework</p>
    <p class="font-mono text-neutral-500 dark:text-neutral-600">
      <%= R.base %>
    </p>
  </footer>
</div>